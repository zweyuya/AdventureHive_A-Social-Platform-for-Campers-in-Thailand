[Unit]
Description=AdventureHive (Django + Gunicorn)
After=network.target postgresql.service

[Service]
User=__APP_USER__
Group=www-data
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
