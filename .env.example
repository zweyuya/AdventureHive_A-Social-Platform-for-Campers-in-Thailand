# Copy to .env and fill in. Never commit .env.
DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://adventurehive:devpass@localhost:5432/adventurehive
ALLOWED_HOSTS=localhost,127.0.0.1

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# Development: React dev server on :5173, cookies over plain HTTP
JWT_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Production (CSIM server) — set these instead:
# DEBUG=False
# ALLOWED_HOSTS=your.server.host
# JWT_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://your.server.host
